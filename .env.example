# PostgreSQL connection string. Use a pooled URL for runtime if your provider recommends it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
OPENAI_API_KEY="sk-your-api-key"
OPENAI_MODEL="gpt-4o-mini"
# USD per 1 million tokens; verify current model pricing before deployment.
INPUT_PRICE_PER_MILLION="0.15"
OUTPUT_PRICE_PER_MILLION="0.60"
# Production URL, used for origin checks if configured.
APP_URL="http://localhost:3000"
